# Private task evidence, module builders, and model-run receipts stay local. Load modules through the app's file picker.
/private/
/*-audit.js
/evidence-module.js
/model-run.js
/model-runs/
/LOCAL_SERVER.json
# Task packages and documents are never committed. tests/fixtures holds the one synthetic zip the tests need.
*.xlsx
*.xlsm
*.xls
*.docx
*.doc
*.pdf
*.zip
*.pptx
!tests/fixtures/**

# The app's own downloads of private material (Finance_Agent_Round_<id>_PRIVATE.json holds the frozen gold and the prompt; the analysis
# workspace and its results use the same suffix; <title>-evaluator-draft-PRIVATE.json, <title>-failure-modes-PRIVATE.txt and
# <title>-working-document-PRIVATE.md use a hyphen). Keep them outside the repository; if one lands inside it, git must not offer it.
# The app's project download (<title>-project.json) holds the private evaluator evidence.
# These two rules come after the tests/fixtures exception above on purpose, so they apply inside tests/fixtures too.
*[_-]PRIVATE.*
*-project.json

# Local scratch space and local assistant settings.
/tmp/
/.claude/settings.local.json

# Rebuilt from the tracked files by `npm run package`; it differs per machine, so it is not versioned.
/FILEBASE_MANIFEST.json

# Headless QA working output. Reports and the retained screenshots are committed explicitly.
qa/**/downloads/
qa/**/invalid-project.json
qa/**/library-fixture.json
qa/**/*.png
!qa/legacy/desktop-failure-modes.png
!qa/legacy/mobile-failure-modes.png
!qa/dashboard/desktop-overview.png
!qa/dashboard/mobile-overview.png
!qa/candidates/desktop-new-cash-candidates.png
!qa/candidates/mobile-new-dividend-candidates.png
!qa/agents/desktop-agents.png
!qa/agents/mobile-agents.png

__pycache__/
.DS_Store
.env
